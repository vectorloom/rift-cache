<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>RiftCache.Providers.Azure</RootNamespace>
    <PackageId>RiftCache.Providers.Azure</PackageId>
    <Description>Azure reference providers for RiftCache — ISecretProvider via Key Vault, IPersistenceProvider via Blob Storage.</Description>
    <PackageTags>cache;distributed-cache;azure;keyvault</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RiftCache\RiftCache.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RiftCache.Providers.Azure.Tests" />
  </ItemGroup>

</Project>
