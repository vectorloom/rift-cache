<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>RiftCache.Azure.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both aliased: RiftCache.Azure.dll and the RiftCache.dll it transitively depends on each
         expose a top-level `Program` type in the global namespace, which collide unless the
         transitive RiftCache.dll reference is also given an explicit alias here. -->
    <ProjectReference Include="..\..\src\RiftCache.Azure\RiftCache.Azure.csproj" Aliases="RiftCacheAzure" />
    <ProjectReference Include="..\..\src\RiftCache\RiftCache.csproj" Aliases="RiftCacheCore" />
  </ItemGroup>

</Project>
